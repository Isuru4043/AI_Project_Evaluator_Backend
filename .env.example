
# Vertex AI Gemini (service-account / ADC authentication)
GOOGLE_APPLICATION_CREDENTIALS=credentials/google-service-account.json
GOOGLE_CLOUD_PROJECT=geminikeyaccess
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional model overrides used by the unified LLM service
# LLM_DEFAULT_MODEL=gemini-3.1-flash-lite
# LLM_FAST_MODEL=gemini-3.1-flash-lite
# LLM_REASONING_MODEL=gemini-3.1-flash-lite
# Optional per-operation chains. These override the broad semantic routes.
# LLM_ANSWER_ANALYSIS_MODEL=gemini-3.1-flash-lite
# LLM_QUESTION_GENERATION_MODEL=gemini-3.1-flash-lite
# LLM_QUESTION_REPAIR_MODEL=gemini-3.1-flash-lite
# LLM_QUESTION_CRITIC_MODEL=gemini-3.1-flash-lite
# LLM_RESPONSE_TRIAGE_MODEL=gemini-3.1-flash-lite
# LLM_FAIRNESS_REVIEW_MODEL=gemini-3.1-flash-lite
# Per-operation prompt budgets. Set 0 to disable a budget.
LLM_PROMPT_MAX_CHARS_ANSWER_ANALYSIS=24000
LLM_PROMPT_MAX_CHARS_QUESTION_GENERATION=20000
LLM_PROMPT_MAX_CHARS_QUESTION_REPAIR=12000
LLM_PROMPT_MAX_CHARS_QUESTION_CRITIC=14000
LLM_PROMPT_MAX_CHARS_RESPONSE_TRIAGE=6000
LLM_PROMPT_MAX_CHARS_FAIRNESS_REVIEW=10000
# Optional cost estimates. Values are USD per 1M input/output tokens.
# Update these from your provider billing page rather than relying on source
# code constants. Leave {} to collect tokens without estimating money.
LLM_MODEL_PRICING_JSON={}
# Example shape:
# LLM_MODEL_PRICING_JSON={"gemini-model-id":{"input":0.0,"output":0.0}}

# Critic outage policy: degraded_tier1 | safe_fallback | fail_closed
VIVA_QUESTION_CRITIC_UNAVAILABLE_POLICY=degraded_tier1

# ElevenLabs question voice (server-side only). Audio starts after Tier 1 and
# runs alongside Critic validation; question text is never delayed by TTS.
ELEVENLABS_TTS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_SECONDS=20
ELEVENLABS_TTS_CACHE_MAX_JOBS=256
# Optional reporting-only price from your current ElevenLabs plan.
ELEVENLABS_PRICE_PER_1000_CHARACTERS_USD=0

# Offline performance gates (used only with question_validation_report --enforce)
VIVA_PERF_MIN_TURNS=20
VIVA_PERF_MAX_P95_TURN_LATENCY_MS=30000
VIVA_PERF_MAX_MEAN_CALLS_PER_TURN=5
VIVA_PERF_MAX_DEGRADED_RATE=0.10
VIVA_PERF_MAX_FALLBACK_RATE=0.05
VIVA_PERF_MIN_TIER1_PASS_RATE=0.95
# Zero disables the cost gate until LLM_MODEL_PRICING_JSON is configured.
VIVA_PERF_MAX_MEAN_COST_PER_TURN_USD=0

# SonarQube / SonarCloud 
SONAR_HOST_URL=https://sonarcloud.io
SONAR_ORG_KEY=
SONAR_TOKEN=
SONAR_SCANNER_BIN=sonar-scanner

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Code analysis tuning (optional)
CODE_ANALYSIS_MAX_ZIP_MB=100
CODE_ANALYSIS_MAX_PROMPT_CHARS=20000
CODE_ANALYSIS_ASYNC=true

# Azure Blob Storage — required for file uploads (reports, video, audio).
# Get these from the storage account: Access keys → Connection string fields.
AZURE_ACCOUNT_NAME=your_storage_account_name
AZURE_ACCOUNT_KEY=your_storage_account_key
AZURE_CONTAINER=media
AZURE_PUBLIC_ACCESS_LEVEL=blob

# RAG retrieval tuning (optional)
# Cross-encoder reranker — set to false to disable for faster/offline runs.
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Bounded process-local retrieval caches (set size 0 to disable one cache)
RAG_QUERY_EMBED_CACHE_SIZE=256
RAG_QUERY_EMBED_CACHE_TTL_SECONDS=900
RAG_MODULE_RESULT_CACHE_SIZE=256
RAG_MODULE_RESULT_CACHE_TTL_SECONDS=900
RAG_KG_SIGNAL_CACHE_SIZE=128
RAG_KG_SIGNAL_CACHE_TTL_SECONDS=900
RAG_RERANK_CACHE_SIZE=256
RAG_RERANK_CACHE_TTL_SECONDS=900

# Agora RTC & STT (video call + live transcription)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=
AGORA_STT_ENABLED=false

# CV / Behavioral analysis (exam-station-cv engine)
# Enable only on machines that have the engine's venv installed.
CV_ANALYSIS_ENABLED=false
CV_ANALYSIS_ASYNC=true
# Defaults to <repo>/exam-station-cv/.venv/Scripts/python.exe
# CV_ANALYSIS_PYTHON=
CV_ANALYSIS_TIMEOUT=1800
# Recording storage: 'local' (default, no Azure cost) or 'azure'
CV_RECORDING_STORAGE=local
# CV_RECORDINGS_DIR=  # defaults to <repo>/cv_recordings

# Agora Cloud Recording (server-side channel recording into Azure)
AGORA_CLOUD_RECORDING_ENABLED=false
# Regional REST edge used for acquire/start/stop. This deployment is hosted in
# Southeast Asia; override it when deploying the backend in another region.
AGORA_REST_BASE_URL=https://api-ap-southeast-1.agora.io
# Agora ignores the region enum for Microsoft Azure; keep the required field 0.
AGORA_RECORDING_AZURE_REGION=0
# Container the composite viva mp4 is written to. Kept separate from `videos`
# so recordings get their own access/retention policy — Agora holds the
# account key to write here. Created automatically if missing.
AZURE_CONTAINER_RECORDINGS=viva-recordings

# Physical evaluation kiosk
# A panel token is revocable and limited to one physical project/session.
PHYSICAL_KIOSK_TOKEN_LIFETIME_HOURS=12
# Physical group identity review. The Modal bind URL is printed by
# `modal deploy cv_analyze_modal.py`; use the same CV_ANALYZE_TOKEN secret.
ATTRIBUTION_BINDING_BACKEND=modal
MODAL_CV_BIND_URL=
MODAL_CV_ENROLL_URL=
MODAL_CV_TOKEN=
ATTRIBUTION_IDENTITY_MIN_CONFIDENCE=0.42
ATTRIBUTION_IDENTITY_MIN_MARGIN=0.05
ATTRIBUTION_IDENTITY_MIN_VOTES=2
NEON_DATABASE_NAME=neondb
NEON_DATABASE_USER=neondb_owner
NEON_DATABASE_PASSWORD=
NEON_DATABASE_HOST=ep-fragrant-dawn-azhkavms.c-3.ap-southeast-1.aws.neon.tech
NEON_DATABASE_PORT=5432
NEON_CHANNEL_BINDING=require
